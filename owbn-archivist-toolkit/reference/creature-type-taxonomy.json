  "_meta": {
    "description": "OWbN Creature Type Taxonomy — canonical mapping of all playable creature types",
    "version": "1.0.0",
    "created": "2026-03-27",
    "structure": "genre > faction/sect > type > variant (where applicable)",
    "notes": [
      "Covers all 274 creature_type values found in oat_characters plus known WoD types not yet in data",
      "default_sect is used for backfilling empty creature_sub_type on characters",
      "genre is used for genre flag columns on reports",
      "Types marked oat_match=true exist in current OAT data; oat_match=false are known WoD types not yet registered"
    ]
  },

